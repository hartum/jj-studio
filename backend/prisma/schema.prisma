datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          Int       @id @default(autoincrement())
  codigo      String    @unique
  nombre      String
  descripcion String    @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  usuarios    Usuario[]

  @@map("roles")
}

model Usuario {
  id                    String              @id @default(uuid())
  nombre                String              @db.VarChar(512)
  apellidos             String              @db.VarChar(512)
  email                 String              @db.VarChar(512)
  emailHash             String?             @unique @map("email_hash")
  telefono              String?             @db.VarChar(512)
  passwordHash          String?             @map("password_hash")
  imagen                String?             @db.LongText
  tipoContrato          String              @default("ASALARIADO") @map("tipo_contrato")
  activo                Boolean             @default(true)
  roleId                Int                 @map("role_id")
  role                  Role                @relation(fields: [roleId], references: [id])
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  deletedAt             DateTime?           @map("deleted_at")
  areasAsignadas        UsuarioArea[]
  hotelesAsignados      UsuarioHotel[]
  sesionesComoFotografo SesionFotografica[] @relation("FotografoSesiones")
  sesionesComoCreador   SesionFotografica[] @relation("CreadorSesiones")
  citasComoVendedor     CitaVenta[]         @relation("VendedorCitas")
  colorAsignado         UsuarioColor?
  metas                 Meta[]
  comisiones            Comision[]
  calendarioLaboral     CalendarioLaboralFotografo[]

  @@map("usuarios")
}

model UsuarioColor {
  id        Int      @id @default(autoincrement())
  usuarioId String   @map("usuario_id")
  color     String   @map("color")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId])
  @@map("usuario_color")
}

model Pais {
  id              Int              @id @default(autoincrement())
  codigo          String           @unique
  nombre          String
  codigoTelefono  String?          @map("codigo_telefono")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  areas           Area[]
  comisionConfigs ComisionConfig[]

  @@map("paises")
}

model Area {
  id                Int           @id @default(autoincrement())
  paisId            Int           @map("id_pais")
  nombre            String
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")
  pais              Pais          @relation(fields: [paisId], references: [id])
  hoteles           Hotel[]
  usuariosAsignados UsuarioArea[]

  @@map("areas")
}

model Hotel {
  id                 Int                 @id @default(autoincrement())
  areaId             Int                 @map("id_area")
  nombre             String              @map("nombre_hotel")
  direccion          String?
  estrellas          Int?
  latitud            Float?
  longitud           Float?
  cadenaHotelera     String?             @map("cadena_hotelera")
  personaContacto    String?             @map("persona_contacto")
  email              String?
  telefono           String?
  metaMensualDefault Float?              @map("meta_mensual_default")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")
  area               Area                @relation(fields: [areaId], references: [id])
  usuariosAsignados  UsuarioHotel[]
  sesiones           SesionFotografica[]
  citasVenta         CitaVenta[]
  metas              Meta[]
  comisiones         Comision[]
  comisionConfigs    ComisionConfig[]

  @@map("hoteles")
}

model UsuarioArea {
  id        Int      @id @default(autoincrement())
  usuarioId String   @map("usuario_id")
  areaId    Int      @map("area_id")
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  area    Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, areaId])
  @@map("usuario_area_acceso")
}

model UsuarioHotel {
  id        Int      @id @default(autoincrement())
  usuarioId String   @map("usuario_id")
  hotelId   Int      @map("hotel_id")
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, hotelId])
  @@map("usuario_hotel_acceso")
}

model SesionFotografica {
  id                    Int        @id @default(autoincrement())
  hotelId               Int        @map("hotel_id")
  fotografoId           String?    @map("fotografo_id")
  creadorId             String     @map("creador_id")
  clienteNombre         String     @map("cliente_nombre")
  clienteEmail          String?    @map("cliente_email")
  clienteTelefono       String?    @map("cliente_telefono")
  numeroHabitacion      String?    @map("numero_habitacion")
  numAdultos            Int        @default(1) @map("num_adultos")
  numNinos              Int        @default(0) @map("num_ninos")
  fechaSalida           DateTime?  @map("fecha_salida")
  concepto              String?    @map("concepto")
  fechaHoraInicio       DateTime   @map("fecha_hora_inicio")
  estado                String     @default("PROGRAMADA")
  origen                String     @default("MANUAL")
  notas                 String?    @db.Text
  googleCalendarEventId String?    @map("google_calendar_event_id")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  deletedAt             DateTime?  @map("deleted_at")

  hotel     Hotel      @relation(fields: [hotelId], references: [id])
  fotografo Usuario?   @relation("FotografoSesiones", fields: [fotografoId], references: [id])
  creador   Usuario    @relation("CreadorSesiones", fields: [creadorId], references: [id])
  citaVenta CitaVenta?

  @@map("sesiones_fotograficas")
}

model CitaVenta {
  id               Int        @id @default(autoincrement())
  sesionId         Int        @unique @map("sesion_id")
  hotelId          Int        @map("hotel_id")
  vendedorId       String?    @map("vendedor_id")
  fechaHoraCita    DateTime   @map("fecha_hora_cita")
  estado           String     @default("PROGRAMADA")
  numFotosVendidas Int?       @map("num_fotos_vendidas")
  totalVentaUsd    Float?     @map("total_venta_usd")
  notas            String?    @db.Text
  googleCalendarEventId String? @map("google_calendar_event_id")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  deletedAt        DateTime?  @map("deleted_at")

  sesion     SesionFotografica @relation(fields: [sesionId], references: [id])
  hotel      Hotel             @relation(fields: [hotelId], references: [id])
  vendedor   Usuario?          @relation("VendedorCitas", fields: [vendedorId], references: [id])
  comisiones Comision[]

  @@map("citas_venta")
}

model Meta {
  id               Int       @id @default(autoincrement())
  alcanceTipo      String    @map("alcance_tipo") // "HOTEL" | "USUARIO"
  hotelId          Int       @map("hotel_id")
  usuarioId        String?   @map("usuario_id")
  anio             Int       @map("anio")
  mes              Int       @map("mes") // 1-12
  importeObjetivo  Float     @map("importe_objetivo")
  sesionesObjetivo Int?      @map("sesiones_objetivo")
  ventasObjetivo   Int?      @map("ventas_objetivo")
  activo           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  hotel   Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([hotelId, usuarioId, anio, mes, alcanceTipo])
  @@map("metas")
}

model ComisionConfig {
  id                     Int       @id @default(autoincrement())
  paisId                 Int?      @map("pais_id")
  hotelId                Int?      @map("hotel_id")
  gerentePct             Float     @default(2.0) @map("gerente_pct")
  supervisorPct          Float     @default(2.0) @map("supervisor_pct")
  fotografoAsalariadoPct Float     @default(14.0) @map("fotografo_asalariado_pct")
  fotografoSinSalarioPct Float     @default(20.0) @map("fotografo_sin_salario_pct")
  vendedorAsalariadoPct  Float     @default(6.0) @map("vendedor_asalariado_pct")
  vendedorSinSalarioPct  Float     @default(8.0) @map("vendedor_sin_salario_pct")
  activo                 Boolean   @default(true)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  pais  Pais?  @relation(fields: [paisId], references: [id], onDelete: Cascade)
  hotel Hotel? @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([paisId, hotelId])
  @@map("comision_config")
}

model Comision {
  id                 Int       @id @default(autoincrement())
  citaVentaId        Int       @map("cita_venta_id")
  hotelId            Int       @map("hotel_id")
  usuarioId          String    @map("usuario_id")
  rolEnVenta         String    @map("rol_en_venta") // "FOTOGRAFO" | "VENDEDOR" | "SUPERVISOR" | "GERENTE"
  tipoContrato       String?   @map("tipo_contrato") // "ASALARIADO" | "SIN_SALARIO"
  porcentajeAplicado Float     @map("porcentaje_aplicado")
  baseCalculoUsd     Float     @map("base_calculo_usd")
  importeComisionUsd Float     @map("importe_comision_usd")
  estado             String    @default("PENDIENTE") // "PENDIENTE" | "APROBADA" | "PAGADA"
  fechaVenta         DateTime  @map("fecha_venta")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  citaVenta CitaVenta @relation(fields: [citaVentaId], references: [id], onDelete: Cascade)
  hotel     Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([citaVentaId, usuarioId, rolEnVenta])
  @@map("comisiones")
}

model CalendarioLaboralFotografo {
  id          Int       @id @default(autoincrement())
  usuarioId   String    @map("usuario_id")
  fechaInicio DateTime  @map("fecha_inicio") @db.Date
  fechaFin    DateTime  @map("fecha_fin") @db.Date
  motivo      String    @default("BAJA")
  notas       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("calendario_laboral_fotografo")
}

